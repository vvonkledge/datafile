# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Benchmark scaffolding. The venv is rebuildable with `uv venv` and the data is
# regenerable with gen_events.py in ~60s, so neither belongs in history. The
# measurements in benchmark/results/ are kept.
benchmark/.venv/
benchmark/data/
benchmark/results/.stdout

# Store runtime state: rebuilt on demand, never source.
*.jsonl.idx
*.jsonl.lock
*.jsonl.quarantine
